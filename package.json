{
  "name": "fixedforall-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-launch.ts && next build && node scripts/csp.ts",
    "serve": "node scripts/serve.ts",
    "lint": "npm run lint:js && npm run lint:css && npm run format:check",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "check:html": "html-validate \"out/**/*.html\"",
    "check:links": "node scripts/check-links.ts",
    "check:launch": "LAUNCH=1 node scripts/check-launch.ts",
    "test": "playwright test",
    "ci": "npm run lint && npm run typecheck && npm run build && npm run check:html && npm run check:links && npm test"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@next/mdx": "^16.4.1",
    "next": "^16.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.1",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "html-validate": "^11.16.2",
    "linkinator": "^8.1.0",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~6.0"
  }
}
